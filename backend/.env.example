# Fidel Assistant — Backend
# Copier vers .env et renseigner les valeurs. Ne jamais committer .env.

APP_NAME=Fidel Assistant
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Production API : https://educampro.edu.cm
PUBLIC_BASE_URL=http://localhost:8000

# Neon Postgres — connection string POOLÉE
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/neondb?ssl=require

# JWT — générer une clé longue et aléatoire en production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# FCM HTTP legacy (optionnel) — push SOS aidants
FCM_SERVER_KEY=
SOS_CANCEL_WINDOW_SECONDS=30
SOS_AIDANT_ACK_TIMEOUT_SECONDS=45
# Cron interne (Railway) — header X-Cron-Secret — voir docs/cron-jobs.md
# Ex. toutes les 15–30 min :
#   curl -X POST "$PUBLIC_BASE_URL/api/v1/internal/jobs/scan-prises-non-confirmees" \
#     -H "X-Cron-Secret: $CRON_SECRET"
#   curl -X POST "$PUBLIC_BASE_URL/api/v1/internal/jobs/mark-prises-manquees" \
#     -H "X-Cron-Secret: $CRON_SECRET"
CRON_SECRET=
# en_attente → manquee après heure_prevue + N heures (défaut 12)
PRISE_MANQUEE_GRACE_HOURS=12

# OTP / sécurité
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_MAX_PER_HOUR=5
TEMP_TOKEN_EXPIRE_MINUTES=15
PASSWORD_MIN_LENGTH=8
CGU_CURRENT_VERSION=v1.0
SOS_CANCEL_WINDOW_SECONDS=30
# Stockage local des voix de rappel (chemin relatif ou absolu)
MEDIA_ROOT=media
# Taille max upload voix (octets) — 2 Mo par défaut
VOIX_RAPPEL_MAX_BYTES=2097152
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15
# Rate limits HTTP /auth (par IP) — désactivés si APP_ENV=test
AUTH_IP_MAX_PER_MINUTE=90
AUTH_SENSITIVE_MAX_ATTEMPTS=30
AUTH_SENSITIVE_WINDOW_MINUTES=15

# Google OAuth — voir docs/google-auth-setup.md
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=

# CORS
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://educampro.edu.cm

# Resend (emails OTP) — domaine vérifié : educampro.edu.cm
RESEND_API_KEY=
EMAIL_FROM=Fidel Assistant <noreply@educampro.edu.cm>
CONTACT_TO_EMAIL=hello@educampro.edu.cm
